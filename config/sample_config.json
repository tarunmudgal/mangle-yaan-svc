{
  "aws": {
    "s3": {
      "bucketName": "csp-e2e-qe",
      "testLogPath": "mangle-yaan/logs/",
      "awsAccessKeyID": "<YOUR_AWS_ACCESS_KEY_ID>",
      "testReportPath": "mangle-yaan/results/",
      "awsSecretAccessKey": "dummy_secret_key",
      "resultTrendsBucketName": "csp-qe-res",
      "resultTrendsHistoryPath": "workloads-history/"
    }
  },
  "csp": {
    "preview": {
      "host": "console-preview.cloud.company.com",
      "defaultOrg": {
        "id": "<YOUR_PREVIEW_ORG_ID>"
      },
      "defaultUser": {
        "id": "<YOUR_PREVIEW_USER_ID>",
        "email": "<YOUR_PREVIEW_USER_EMAIL>",
        "accessToken": "",
        "refreshToken": "<YOUR_PREVIEW_CSP_REFRESH_TOKEN>"
      },
      "defaultService": {
        "id": "<YOUR_PREVIEW_SERVICE_ID>"
      },
      "defaultBillingAccount": {
        "id": "<YOUR_PREVIEW_BILLING_ACCOUNT_ID>"
      },
       "defaultOnboardingContext": {
        "id": "<YOUR_PREVIEW_ONBOARDING_CONTEXT_ID>"
      }
    },
    "dev": {
      "host": "console-dev.cloud.company.com",
      "defaultOrg": {
        "id": "<YOUR_DEV_ORG_ID>"
      },
      "defaultUser": {
        "id": "<YOUR_DEV_USER_ID>",
        "email": "<YOUR_DEV_USER_EMAIL>",
        "accessToken": "",
        "refreshToken": "<YOUR_DEV_CSP_REFRESH_TOKEN>"
      },
      "defaultService": {
        "id": "<YOUR_DEV_SERVICE_ID>"
      }
    },
    "decc": {
      "host": "csp-console-ara-csp-smantu.ara.decc.company.com",
      "defaultOrg": {
        "id": "<YOUR_DECC_ORG_ID>"
      },
      "defaultUser": {
        "id": "<YOUR_DECC_USER_ID>",
        "email": "<YOUR_DECC_USER_EMAIL>",
        "accessToken": "",
        "refreshToken": "<YOUR_DECC_CSP_REFRESH_TOKEN>"
      },
      "defaultService": {
        "id": "<YOUR_DECC_SERVICE_ID>"
      },
      "defaultBillingAccount": {
        "id": "<YOUR_DECC_BILLING_ACCOUNT_ID>"
      },
       "defaultOnboardingContext": {
        "id": "<YOUR_DECC_ONBOARDING_CONTEXT_ID>"
      }
    }
  },
  "mangle": {
    "host": "<YOUR_MANGLE_HOST>",
    "password": "<YOUR_MANGLE_PASSWORD>",
    "username": "<YOUR_MANGLE_USERNAME>"
  },
  "k8sCluster": {
    "preview": {
      "namespace": "csp-app-preview",
      "endpointName": "csp-app-preview",
      "credentialName": "csp-app-preview",
      "kubeConfigFileName": "csp-app-preview.yaml"
    },
    "dev": {
      "namespace": "csp-app-dev",
      "endpointName": "csp-app-dev",
      "credentialName": "csp-app-dev",
      "kubeConfigFileName": "csp-app-dev.yaml"
    },
    "decc": {
      "namespace": "ara-csp-smantu",
      "endpointName": "ara-csp-smantu",
      "credentialName": "ara-csp-smantu",
      "kubeConfigFileName": "ara-csp-smantu.yaml"
    }
  },
  "mangleYaan": {
    "webDriver": {
      "initLocal": false,
      "chromeDriverPath": "<YOUR_CHROMEDRIVER_PATH>"
    },
    "testLogPath": "logs/test_runner.log",
    "testReportPath": "logs/mangle-yaan-test-report-{timeStamp}.html",
    "retryFailedTests": {
      "maxRuns": 2,
      "minPasses": 1
    }
  },
  "projectName": "csp_resiliency",
  "projectDescription": "CSP Resiliency Test Suite"
}